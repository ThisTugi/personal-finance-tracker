<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox spacing="15" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.AddTransactionController" style="-fx-padding: 20;">
    <Label text="Yeni İşlem Ekle" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    
    <GridPane hgap="10" vgap="10">
        <Label fx:id="lblAsset" text="Varlık Adı:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="cbAsset" editable="true" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        
        <Label text="İşlem Türü:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="cbType" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        
        <Label fx:id="lblAmount" text="Miktar:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="txtAmount" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        
        <Label fx:id="lblPrice" text="Fiyat:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="3">
            <TextField fx:id="txtPrice" HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="cbCurrency" prefWidth="80"/>
        </HBox>
        
        <Label text="Kategori:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <ComboBox fx:id="cbCategory" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
    </GridPane>
    
    <Label fx:id="lblError" textFill="red"/>
    
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="İptal" onAction="#handleCancel"/>
        <Button text="Kaydet" onAction="#handleSave"/>
    </HBox>
</VBox>
