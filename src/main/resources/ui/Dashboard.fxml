<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.DashboardController" stylesheets="@style.css">
    <top>
        <HBox spacing="20" alignment="CENTER" style="-fx-padding: 20;">
            <VBox styleClass="summary-card">
                <Label text="Toplam Portföy"/>
                <Label fx:id="lblTotalPortfolio" text="0.0 TL" styleClass="amount-label"/>
            </VBox>
            <VBox styleClass="summary-card">
                <Label text="Aylık Gider"/>
                <Label fx:id="lblMonthlyExpense" text="0.0 TL" styleClass="amount-label"/>
            </VBox>
            <VBox styleClass="summary-card">
                <Label text="Net Kâr/Zarar (Portföy)"/>
                <Label fx:id="lblNetPnL" text="0.0 TL" styleClass="amount-label"/>
            </VBox>
        </HBox>
    </top>
    <center>
        <VBox spacing="10" style="-fx-padding: 20;">
            <HBox spacing="10">
                <Button text="Yenile" onAction="#handleRefresh"/>
                <Button text="Yeni İşlem Ekle" onAction="#handleAddTransaction"/>
                <Button text="Seçili İşlemi Sil" onAction="#handleDeleteTransaction"/>
                <Button text="Dışa Aktar (CSV)" onAction="#handleExport"/>
            </HBox>
            <TableView fx:id="transactionTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="40"/>
                    <TableColumn fx:id="colAsset" text="Varlık / Açıklama" prefWidth="130"/>
                    <TableColumn fx:id="colType" text="Tür" prefWidth="60"/>
                    <TableColumn fx:id="colAmount" text="Adet" prefWidth="60"/>
                    <TableColumn fx:id="colPrice" text="Alış Fiyatı" prefWidth="110"/>
                    <TableColumn fx:id="colTotal" text="Toplam" prefWidth="110"/>
                    <TableColumn fx:id="colCurrentPrice" text="Güncel Fiyat" prefWidth="115"/>
                    <TableColumn fx:id="colPnL" text="Kâr/Zarar" prefWidth="110"/>
                    <TableColumn fx:id="colDate" text="Tarih" prefWidth="90"/>
                    <TableColumn fx:id="colCategory" text="Kategori" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>
    </center>
    <right>
        <TabPane fx:id="chartTabPane" style="-fx-padding: 10;" prefWidth="320" tabClosingPolicy="UNAVAILABLE">
            <Tab text="Varlıklarım">
                <StackPane fx:id="summaryChartContainer" prefWidth="300" prefHeight="300"/>
            </Tab>
            <Tab text="Gider Dağılımı">
                <StackPane fx:id="expenseChartContainer" prefWidth="300" prefHeight="300"/>
            </Tab>
            <Tab text="Gelir Dağılımı">
                <StackPane fx:id="incomeChartContainer" prefWidth="300" prefHeight="300"/>
            </Tab>
        </TabPane>
    </right>
</BorderPane>
